# ==========================================
# CLOUD.RU FOUNDATION MODELS - EMBEDDINGS
# ==========================================
API_KEY=
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1
CLOUDRU_EMBEDDING_MODEL=ai-sage/Giga-Embeddings-instruct-3B

# ==========================================
# GIGACHAT - TEXT GENERATION
# ==========================================
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro

# ==========================================
# CLOUD.RU OBJECT STORAGE
# ==========================================
S3_ENDPOINT_URL=https://s3.cloud.ru
S3_REGION=ru-central-1
S3_TENANT_ID=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=clinical-rag-documents

# ==========================================
# CLICKHOUSE - DATABASE
# ==========================================
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=clinical_rag

# ==========================================
# APPLICATION
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
TOP_K=5
